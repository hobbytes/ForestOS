# Forest OS — пример окружения.
# Скопируйте в .env и ОБЯЗАТЕЛЬНО поменяйте все пароли перед публикацией в интернет.
# .env не попадает в git (см. .gitignore).

APP_PORT=8080
APP_TIMEZONE=Europe/Moscow

# --- база данных ------------------------------------------------------------
DB_HOST=db
DB_NAME=forestos
DB_USER=forest
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# --- первый пользователь (создаётся при первом запуске) ---------------------
FOREST_ADMIN_LOGIN=admin
FOREST_ADMIN_PASSWORD=change_me_admin_password
FOREST_ADMIN_LANGUAGE=ru
FOREST_ADMIN_TIMEZONE=Europe/Moscow

# --- необязательный облачный режим (выдача FUID) ----------------------------
FOREST_CLOUD_ENABLED=false
FOREST_CLOUD_URL=https://forest.example.com
FOREST_CLOUD_TOKEN=

# --- прочее -----------------------------------------------------------------
# 1 = пропустить bootstrap при старте контейнера
FOREST_SKIP_BOOTSTRAP=0
